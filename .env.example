# Copy to .env.local and fill in. .env.local is git-ignored.
# The app boots with ALL of these blank (mock AI, no database).

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- AI provider ----
# "mock" (default, deterministic, offline) or "gemini".
# If "gemini" is set but GEMINI_API_KEY is empty, the app falls back to mock.
AI_PROVIDER=mock
GEMINI_API_KEY=

# ---- Database (Supabase Postgres) ----
# Pooled connection (Supavisor / PgBouncer, port 6543) — used by the app runtime.
DATABASE_URL=
# Direct connection (port 5432) — used by drizzle-kit for migrations.
DIRECT_URL=

# ---- Supabase Auth + Storage ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never exposed to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
